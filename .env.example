# Neon Serverless PostgreSQL Database URLs
# Pooled connection string (used by Prisma Client at runtime)
DATABASE_URL=""
# Direct connection string (used by Prisma CLI for migrations / db push)
DIRECT_URL=""

# JWT Secret for Session Authentication
JWT_SECRET="replace_with_a_secure_random_64_character_string"

# Application Public URL
NEXT_PUBLIC_APP_URL=""
NODE_ENV=""

# (Optional) Cloudflare R2 / Cloudinary Object Storage
CLOUDFLARE_R2_BUCKET=""
CLOUDFLARE_API_TOKEN=""

# Google Analytics (GA4) Tracking ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=""

