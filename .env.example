# Neon Serverless PostgreSQL Database URLs
# Pooled connection string (used by Prisma Client at runtime)
DATABASE_URL="postgresql://neondb_owner:your_password@ep-your-endpoint-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
# Direct connection string (used by Prisma CLI for migrations / db push)
DIRECT_URL="postgresql://neondb_owner:your_password@ep-your-endpoint.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# JWT Secret for Session Authentication
JWT_SECRET="replace_with_a_secure_random_64_character_string"

# Application Public URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# (Optional) Cloudflare R2 / Cloudinary Object Storage
CLOUDFLARE_R2_BUCKET=""
CLOUDFLARE_API_TOKEN=""
